[Unit]
Description=Civ6 server Key access and room management
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=PYTHONIOENCODING=utf-8
ExecStart=/usr/bin/python3 /opt/civ6-relay/keyservice.py --state-dir /var/lib/civ6-relay-keys serve --listen 127.0.0.1 --port 15888
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
