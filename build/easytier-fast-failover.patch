+#[tokio::test]
+async fn relay_sessions_gc_keeps_traffic_and_releases_idle_state() {
+    for receive in [false, true] {
+        let (sender, _receiver) = create_packet_recv_chan();
+        let ctx = get_mock_global_ctx_with_network(Some(NetworkIdentity::new(
+            "relay-gc".to_string(), "secret".to_string(),
+        )));
+        set_secure_mode_cfg(&ctx, true);
+        let peers = Arc::new(PeerMap::new(sender, ctx.clone(), 10));
+        let store = Arc::new(PeerSessionStore::new());
+        let relay = RelayPeerMap::new(peers, None, ctx.clone(), 10, store.clone());
+        let key = SessionKey::new(ctx.get_network_name(), 20);
+        let session = || Arc::new(PeerSession::new(
+            20, [9u8; 32], 1, 0,
+            "aes-256-gcm".to_string(), "aes-256-gcm".to_string(), None,
+        ));
+        store.insert_session(key.clone(), session());
+        let mut packet = ZCPacket::new_with_payload(b"relay activity");
+        if receive {
+            packet.fill_peer_manager_hdr(20, 10, PacketType::Data as u8);
+            session().encrypt_payload(20, 10, &mut packet).unwrap();
+            assert!(relay.decrypt_if_needed(&mut packet).await.unwrap());
+        } else {
+            packet.fill_peer_manager_hdr(10, 20, PacketType::Data as u8);
+            let _ = relay.send_msg(packet, 20, NextHopPolicy::LeastHop).await;
+        }
+        store.evict_unused_sessions();
+        assert!(store.get(&key).is_some(), "active relay session was collected");
+        relay.evict_idle_sessions(Duration::ZERO);
+        store.evict_unused_sessions();
+        assert!(store.get(&key).is_none(), "idle relay session was retained");
+    }
