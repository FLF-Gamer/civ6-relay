+//! Data-path health is independent from connection lifetime. A failed probe
+//! enables the prepared relay; two newer successful probes restore direct use.
+#[derive(Default)]
+pub(crate) struct ProbeHealth {
+    last_seq: Option<u32>,
+    good: u8,
+    suspect: bool,
+}
+
+impl ProbeHealth {
+    pub(crate) fn observe(&mut self, seq: u32, success: bool) -> Option<bool> {
+        if let Some(last) = self.last_seq {
+            let delta = seq.wrapping_sub(last);
+            if delta == 0 || delta >= (1 << 31) {
+                return None;
+            }
+        }
+        self.last_seq = Some(seq);
+        if success {
+            self.good = self.good.saturating_add(1);
+            if self.good >= 2 {
+                self.suspect = false;
+            }
+        } else {
+            self.good = 0;
+            self.suspect = true;
+        }
+        Some(self.suspect)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ProbeHealth;
+
+    #[test]
+    fn first_failure_relays_and_two_new_successes_restore() {
+        let mut h = ProbeHealth::default();
+        assert_eq!(h.observe(1, false), Some(true));
+        assert_eq!(h.observe(2, true), Some(true));
+        assert_eq!(h.observe(3, true), Some(false));
+    }
+
+    #[test]
+    fn late_outcomes_cannot_override_newer_health() {
+        let mut h = ProbeHealth::default();
+        assert_eq!(h.observe(5, true), Some(false));
+        assert_eq!(h.observe(6, true), Some(false));
+        assert_eq!(h.observe(4, false), None);
+        assert_eq!(h.observe(7, false), Some(true));
+        assert_eq!(h.observe(6, true), None);
+        assert_eq!(h.observe(8, true), Some(true));
+        assert_eq!(h.observe(8, true), None);
+        assert_eq!(h.observe(9, true), Some(false));
+    }
+
+    #[test]
+    fn wrapping_probe_sequence_keeps_progress() {
+        let mut h = ProbeHealth::default();
+        assert_eq!(h.observe(u32::MAX - 1, false), Some(true));
+        assert_eq!(h.observe(u32::MAX, true), Some(true));
+        assert_eq!(h.observe(0, true), Some(false));
+        assert_eq!(h.observe(u32::MAX, false), None);
+    }
+}
